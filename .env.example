# Convex (written automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk (from https://dashboard.clerk.com/last-active?path=api-keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Frontend API URL (from https://dashboard.clerk.com/apps/setup/convex).
# Must ALSO be set as CLERK_JWT_ISSUER_DOMAIN in the Convex dashboard environment,
# otherwise ctx.auth.getUserIdentity() returns null.
CLERK_JWT_ISSUER_DOMAIN=

# Clerk redirect targets
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# OpenRouter (all AI features; model pinned in convex/lib/ai.ts).
# Must ALSO be set as OPENROUTER_API_KEY in the Convex deployment environment,
# because AI agents run as Convex actions.
OPENROUTER_API_KEY=

# Google Maps Embed API (browser key, inlined at build via NEXT_PUBLIC_).
# Restrict the key to the Maps Embed API and unitdeck.app referrers in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Convex deployment environment only (not read from this file) ---
# Set these in the Convex dashboard (or `npx convex env set`); email actions
# throw without them:
#   RESEND_API_KEY  - Resend key for call sheet / document / feedback emails
#   W3W_API_KEY     - what3words API key (api.what3words.com). Without it the
#                     what3words field on a location stays blank: a w3w address
#                     is an arbitrary grid reference, so it is never guessed.
#   SITE_URL        - public site origin used in email links. Prod: https://unitdeck.app
#                     Dev deployment: http://localhost:3000 (a prod URL here makes
#                     dev-sent emails link to tokens that only exist in dev data)
# (CLERK_JWT_ISSUER_DOMAIN and OPENROUTER_API_KEY must also be set there; see above.)
